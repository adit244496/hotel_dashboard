# Local / on-premise configuration.
# The database runs in Docker (see docker-compose.yml) on port 5434, chosen so
# it does not collide with a locally installed PostgreSQL on 5432/5433.
DATABASE_URL=postgresql+psycopg://hotel:hotel@localhost:5434/hotel_dashboard

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
STORAGE_DIR=storage/uploads
RETENTION_YEARS=2

FIRST_ADMIN_EMAIL=admin@hotelgroup.in
FIRST_ADMIN_PASSWORD=change-me

# Where the app is published. Used for CORS and printed on startup.
PUBLIC_BASE_URL=https://hospkpi.ambujaneotia.com
HOST=0.0.0.0
PORT=8016

# Serve the built frontend from this process, so one port serves the whole app.
SERVE_FRONTEND=true

# The public URL is added automatically; list any extra origins here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://hospkpi.ambujaneotia.com:8016,https://hospkpi.ambujaneotia.com:8016
