# Copy to .env and fill in. Never commit .env.
#
# DATABASE_URL
#   Server (PostgreSQL installed on the host, default port 5432):
#     postgresql+psycopg://hotel_user:PASSWORD@localhost:5432/hotel_db
#   Local development against the Docker database in docker-compose.yml:
#     postgresql+psycopg://hotel:hotel@localhost:5434/hotel_dashboard
#
#   IMPORTANT: percent-encode special characters in the password, or the URL is
#   parsed wrongly and the failure is confusing rather than obvious. A password
#   of Hotel@123 must be written Hotel%40123 - unencoded, the '@' is read as the
#   host separator and SQLAlchemy tries to connect to a host called '123@localhost'.
#     @ -> %40   : -> %3A   / -> %2F   # -> %23   ? -> %3F   % -> %25
DATABASE_URL=postgresql+psycopg://hotel_user:CHANGE%40ME@localhost:5432/hotel_db

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
STORAGE_DIR=storage/uploads
RETENTION_YEARS=2

FIRST_ADMIN_EMAIL=admin@hotelgroup.in
FIRST_ADMIN_PASSWORD=change-me

# Where the app is published. Used for CORS and printed on startup.
PUBLIC_BASE_URL=https://hospkpi.ambujaneotia.com
HOST=0.0.0.0
PORT=8016

# Serve the built frontend from this process, so one port serves the whole app.
SERVE_FRONTEND=true

# The public URL is added automatically; list any extra origins here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://hospkpi.ambujaneotia.com:8016,https://hospkpi.ambujaneotia.com:8016
