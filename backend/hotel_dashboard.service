# systemd unit for the Hotel Performance Dashboard.
#
#   sudo cp hotel_dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hotel_dashboard
#   sudo systemctl status hotel_dashboard
#   journalctl -u hotel_dashboard -f          # logs
#
# Paths assume the checkout at ~srvadmin/hotel_dashboard/hotel_dashboard.
# This is a FastAPI (ASGI) app, so it runs under uvicorn — not gunicorn's
# default WSGI worker, which cannot serve it.

[Unit]
Description=Hotel Performance Dashboard (FastAPI)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=srvadmin
Group=srvadmin
WorkingDirectory=/home/srvadmin/hotel_dashboard/hotel_dashboard/backend
EnvironmentFile=/home/srvadmin/hotel_dashboard/hotel_dashboard/backend/.env
ExecStart=/home/srvadmin/hotel_dashboard/hotel_dashboard/backend/venv/bin/python -m uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8016 \
    --workers 2 \
    --proxy-headers \
    --forwarded-allow-ips='*'
Restart=on-failure
RestartSec=5

# PostgreSQL may still be replaying its WAL just after a reboot, so allow a
# generous number of restarts before systemd gives up.
StartLimitIntervalSec=300
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
